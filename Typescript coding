            Optional chaining 
یہ code runtime پر error دے گا، کیونکہ user.address موجود نہیں ہے۔
type User = {
  name: string;
  address?: {
    city: string;
  };
};

const user: User = {
  name: "Ali"
};

console.log(user.address?.city);
