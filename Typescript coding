                          Intersection type
    آسان الفاظ میں: اگر ایک Type
 میں User کا نام ہو اور دوسرے Type میں عمر  تو Intersection Type کے ذریعے دونوں کو ملا کر ایک ایسا Type بنا سکتے ہیں جس میں نام اور عمر دونوں موجود ہوں۔
  type Person = {
  name: string;
};

type Employee = {
  salary: number;
};

type Worker = Person & Employee;

let user: Worker = {
  name: "Ali",
  salary: 50000
};

console.log(user.name);
console.log(user.salary);
